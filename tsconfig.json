{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": ["@kekkon-nexus/config/ts", "@kekkon-nexus/config/ts/strict"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,

		"jsx": "react-jsx",
		"lib": ["dom"],

		"noEmit": true,
		"types": [
			"@types/node",
			"@types/react",
			"@types/react-dom",
			"vite-plus/client"
		],
		"skipLibCheck": true
	},
	"exclude": ["./dist"]
}
