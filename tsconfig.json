{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": ["@kekkon-nexus/config/ts", "@kekkon-nexus/config/ts/strict"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,

		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["@types/node", "vite-plus/client"],
		"skipLibCheck": true
	},
	"exclude": ["./dist"]
}
